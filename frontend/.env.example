# =============================================================================
#  Velocity Frontend — environment variables
#
#  Copy to `.env.local` for local development. None of these contain secrets;
#  they are all `NEXT_PUBLIC_*` and therefore visible in the client bundle.
# =============================================================================

# REST API base URL (Drogon API gateway).
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Leaderboard WebSocket endpoint (uWebSockets fan-out service).
NEXT_PUBLIC_LEADERBOARD_WS=ws://localhost:8090/v1/leaderboard

# Demo mode. When set to "1", every data hook serves canned mock data from
# `lib/demo-data.ts` instead of calling the backend. Useful when the C++/Go
# services aren't running locally — e.g. UI work on a laptop without Docker.
NEXT_PUBLIC_DEMO_MODE=0

# Deployment environment label shown in the top-nav (`env.dev`, `env.prod`,
# etc.). Has no functional impact.
NEXT_PUBLIC_VELOCITY_ENV=dev

# Jaeger UI base URL. The submission detail page renders a "View trace →" link
# to `${NEXT_PUBLIC_JAEGER_URL}/trace/{trace_id}` so judges can walk the full
# benchmark waterfall (gateway → controller → 100 bot workers → validator →
# scoring) in one click. Leave at default for the docker-compose stack.
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
