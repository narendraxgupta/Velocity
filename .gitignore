# =============================================================================
# Velocity — Distributed Trading Benchmark Platform
# Top-level .gitignore
# =============================================================================

# ----- Build artifacts -------------------------------------------------------
build/
build-*/
out/
cmake-build-*/
_deps/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cache/

# ----- Conan -----------------------------------------------------------------
conan-cache/
.conan/
conanbuildinfo.*
conaninfo.txt
conan.lock
graph_info.json
CMakeUserPresets.json

# ----- C++ compiled output ---------------------------------------------------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.exp
*.map
*.gch
*.pch

# ----- Generated protobuf ----------------------------------------------------
# Generated files are ignored, but we keep the proto/gen/go/go.mod stub
# checked in so the Go submission engine can build without a separate
# manifest-generation step (its replace directive points here).
proto/gen/
!proto/gen/go/
proto/gen/go/*
!proto/gen/go/go.mod
**/*.pb.h
**/*.pb.cc
**/*.pb.go
**/*.grpc.pb.h
**/*.grpc.pb.cc
**/*_pb2.py
**/*_pb2_grpc.py

# ----- Go --------------------------------------------------------------------
**/vendor/
*.test
*.out
coverage.out
go.work
go.work.sum

# ----- Node / Next.js --------------------------------------------------------
node_modules/
.next/
.turbo/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm/
.eslintcache
.stylelintcache
.tsbuildinfo
next-env.d.ts

# ----- IDEs ------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- OS noise --------------------------------------------------------------
.AppleDouble
.LSOverride
Icon
._*

# ----- Docker / Compose ------------------------------------------------------
.docker/
docker-compose.override.yml

# ----- Logs & runtime data ---------------------------------------------------
logs/
*.log
*.pid
*.seed
*.pid.lock
runtime/
data/
volumes/

# ----- Test / benchmark output -----------------------------------------------
benchmark-results/
*.hgrm
*.hdr
*.perf
flamegraph.svg
perf.data
perf.data.old
callgrind.out.*
massif.out.*

# ----- Secrets ---------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
!**/example.key
secrets/
!secrets/.gitkeep

# ----- Terraform -------------------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# ----- Kubernetes ------------------------------------------------------------
kubeconfig
*.kubeconfig

# ----- Python tooling (used in some scripts) --------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# ----- Misc ------------------------------------------------------------------
*.bak
*.tmp
*.orig
.history/
