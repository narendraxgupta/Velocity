# EditorConfig — universal indentation, line endings, charset
# https://editorconfig.org

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4
max_line_length          = 100

# C++ — Google-ish width, but capped at 100 for readability on small screens
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp,inl}]
indent_size              = 4
max_line_length          = 100

# Go — tabs are the language standard
[*.go]
indent_style             = tab
indent_size              = 4

# Web frontend
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size              = 2
max_line_length          = 100

[*.{json,jsonc,json5,yaml,yml,toml}]
indent_size              = 2

[*.md]
trim_trailing_whitespace = false
max_line_length          = off

[Makefile]
indent_style             = tab

[*.proto]
indent_size              = 2

[*.{sh,bash}]
indent_size              = 2

[*.{ps1,psm1,psd1}]
end_of_line              = crlf
indent_size              = 4
